# Copy this file to .env and add your own credentials.
# Never commit .env or real broker credentials.
APP_NAME=Sevenseas Capital API
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+asyncpg://sevenseas:sevenseas@localhost:5432/sevenseas
REDIS_URL=redis://localhost:6379/0
GROWW_API_KEY=
GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=
GROWW_API_SECRET=
GROWW_REDIRECT_URL=http://localhost:8000/api/v1/auth/groww/callback
GROWW_ACCESS_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis Cache Configuration (in seconds)
CACHE_ENABLED=true
CACHE_TTL_LIVE_PRICE=2
CACHE_TTL_INDICES=5
CACHE_TTL_OHLC=60
CACHE_TTL_HISTORICAL=600
CACHE_TTL_MARKET_CLOSED=300
CACHE_TTL_LAST_CLOSE=86400
CACHE_STALE_RETENTION=604800
